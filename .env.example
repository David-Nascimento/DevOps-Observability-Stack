# Copie para .env e troque as senhas. O arquivo .env não vai para o Git.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=troque-esta-senha
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# Destino dos alertas do Grafana (webhook). Vazio = os alertas aparecem só na tela do Grafana.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Versões das imagens. Para fixar: rode "docker compose images", copie as versões e descomente.
# PROMETHEUS_VERSION=
# LOKI_VERSION=
# ALLOY_VERSION=
# GRAFANA_VERSION=
# CADVISOR_VERSION=
# NODE_EXPORTER_VERSION=
# SELENIUM_VERSION=
# SERVEREST_VERSION=
# DOCKER_SOCKET_PROXY_VERSION=
