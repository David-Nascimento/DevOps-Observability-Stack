{
  "uid": "jenkins-karate",
  "title": "Jenkins e esteira de testes",
  "tags": [
    "observabilidade"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Resultado do último build (por job)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "default_jenkins_builds_last_build_result_ordinal{jenkins_job=~\".+\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{jenkins_job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SUCESSO",
                  "color": "green"
                },
                "1": {
                  "text": "INSTÁVEL",
                  "color": "yellow"
                },
                "2": {
                  "text": "FALHA",
                  "color": "red"
                },
                "3": {
                  "text": "ABORTADO",
                  "color": "gray"
                },
                "4": {
                  "text": "N/A",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "links": [
        {
          "title": "Abrir esteira no Jenkins",
          "url": "http://localhost:8080/job/esteira-qa/",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Duração do último build (por job)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "default_jenkins_builds_last_build_duration_milliseconds{jenkins_job=~\".+\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{jenkins_job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "links": [
        {
          "title": "Abrir esteira no Jenkins",
          "url": "http://localhost:8080/job/esteira-qa/",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Testes no último build (por job)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "default_jenkins_builds_last_build_tests_total{jenkins_job=~\".+\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{jenkins_job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "links": [
        {
          "title": "Abrir esteira no Jenkins",
          "url": "http://localhost:8080/job/esteira-qa/",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Testes com falha",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "default_jenkins_builds_last_build_tests_failing{jenkins_job=~\".+\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{jenkins_job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "links": [
        {
          "title": "Abrir esteira no Jenkins",
          "url": "http://localhost:8080/job/esteira-qa/",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Duração dos builds",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "default_jenkins_builds_last_build_duration_milliseconds",
          "legendFormat": "{{jenkins_job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fila e executores",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "default_jenkins_queue_size_value",
          "legendFormat": "fila",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "default_jenkins_executors_available",
          "legendFormat": "executores livres",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Testes: total, falhas e ignorados",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "default_jenkins_builds_last_build_tests_total{jenkins_job=~\".+\"}",
          "legendFormat": "{{jenkins_job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "default_jenkins_builds_last_build_tests_failing{jenkins_job=~\".+\"}",
          "legendFormat": "{{jenkins_job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "default_jenkins_builds_last_build_tests_skipped{jenkins_job=~\".+\"}",
          "legendFormat": "{{jenkins_job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Builds com sucesso e com falha (acumulado)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "default_jenkins_builds_success_build_count",
          "legendFormat": "sucesso - {{jenkins_job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "default_jenkins_builds_failed_build_count",
          "legendFormat": "falha - {{jenkins_job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Taxa de sucesso dos builds",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (jenkins_job) (default_jenkins_builds_success_build_count) / (sum by (jenkins_job) (default_jenkins_builds_success_build_count) + sum by (jenkins_job) (default_jenkins_builds_failed_build_count))",
          "legendFormat": "{{jenkins_job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Taxa de sucesso atual",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (jenkins_job) (default_jenkins_builds_success_build_count) / (sum by (jenkins_job) (default_jenkins_builds_success_build_count) + sum by (jenkins_job) (default_jenkins_builds_failed_build_count))",
          "legendFormat": "{{jenkins_job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Duração média dos builds (janela de 24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(default_jenkins_builds_last_build_duration_milliseconds[24h])",
          "legendFormat": "{{jenkins_job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Jenkins",
      "type": "link",
      "url": "http://localhost:8080",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "Prometheus (alvos)",
      "type": "link",
      "url": "http://localhost:9090/targets",
      "targetBlank": true,
      "icon": "external link"
    }
  ]
}